    "safe-add": {
      "source": "core/SafeInt.carp",
      "line": 4,
      "original": "Performs an addition and checks whether it overflowed.",
      "source_html_sha256": "147b73aad4a07ca32a027bfe565bce2856912af1a9be4145954af9a09d314e45",
      "translation": "加算を行い、オーバーフローが発生したかどうかを検査します。"
    },
    "safe-mul": {
      "source": "core/SafeInt.carp",
      "line": 8,
      "original": "Performs an multiplication and checks whether it overflowed.",
      "source_html_sha256": "64705926603bddc11c4be1c863233488fb2f8687147d9a8a896cf1cfb8446c35",
      "translation": "乗算を行い、オーバーフローが発生したかどうかを検査します。"
    },
    "safe-sub": {
      "source": "core/SafeInt.carp",
      "line": 6,
      "original": "Performs an substraction and checks whether it overflowed.",
      "source_html_sha256": "d465579b0351041ebcafd89046fc8f0781ad54a9654234a4c2c4c6a02073dc22",
      "translation": "減算を行い、オーバーフローが発生したかどうかを検査します。"
    },
    "sign": {
      "source": "core/Int.carp",
      "line": 130,
      "original": "Returns `-1` if `n` is negative, `0` if zero, or `1` if positive.",
      "source_html_sha256": "56a092dbe7e4b39480e1b8420c97a59aef78606a9a29f863e5facd050d687c1a",
      "translation": "`n` が負の場合は `-1`、ゼロの場合は `0`、正の場合は `1` を返します。"
    },
    "str": {
      "source": "core/String.carp",
      "line": 316,
      "original": "Converts an integer to a string.",
      "source_html_sha256": "aa54e3a79bbe1189ea4d26ad81e36eea1c1b8de31eb7528353c509032d34f56a",
      "translation": "整数を文字列に変換します。"
    },
    "to-int": {
      "source": "core/Int.carp",
      "line": 30,
      "original": "acts as the identity function to implement the interface.",
      "source_html_sha256": "171237ed373c71ac417e0e4b17a18c1514606a47ec46384f4dcffa57cb726408",
      "translation": "インターフェースを実装するための恒等関数として動作します。"
    },
    "unsafe-format": {
      "source": "core/String.carp",
      "line": 319,
      "original": "Formats an integer. Unchecked: `s` must hold exactly one format directive. Prefer `fmt`, which checks that at compile time.",
      "source_html_sha256": "3cc783c8a43284d54e74d2e7d389e74bc30658ddfb1856c59452be15ca6a332f",
      "translation": "整数を書式化します。検査は行いません。`s` には変換指定 (directive) がちょうど 1 つ含まれている必要があります。コンパイル時にこれを検査する [`fmt`](../../docs/Format_Strings-JP.html) の使用を推奨します。"
    },
    "zero": {
      "source": "core/Int.carp",
      "line": 94,
      "original": "returns the zero value for Int (0), used to implement the `zero` interface.",
      "source_html_sha256": "11113dd66b704a70182631a81b96da18f1e63fbc36ee1fd1f69e03ccf36cb0a4",
      "translation": "`zero` インターフェースの実装に使われる、`Int` のゼロ値 (`0`) を返します。"
    }
