    },
    "dec": {
      "source": "core/Int.carp",
      "line": 23,
      "original": "decrements an Int by 1.",
      "source_html_sha256": "7a1d15a146975e5fa332ee5027e3fbb505cd48d32b1e9537e51f97f40c4c70a4",
      "translation": "`Int` を `1` 減らします。"
    },
    "even?": {
      "source": "core/Int.carp",
      "line": 84,
      "original": "returns true if `a` is even.",
      "source_html_sha256": "5c4aafe54d2a6c1a7bf7797852dc35a2b2e967b266548b92e7198d51594278e9",
      "translation": "`a` が偶数の場合に `true` を返します。"
    },
    "from-int": {
      "source": "core/Int.carp",
