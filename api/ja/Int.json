    },
    "odd?": {
      "source": "core/Int.carp",
      "line": 86,
      "original": "returns true if `a` is odd.",
      "source_html_sha256": "56b3e2000cb840891184977f49ba4b4f7e448e86fc427efcdd6030ffafc545e7",
      "translation": "`a` が奇数の場合に `true` を返します。"
    },
    "positive-mod": {
      "source": "core/Int.carp",
      "line": 123,
      "original": "Like mod but always returns a positive answer.",
      "source_html_sha256": "6fb90f2297d6729eb0f5264840622c9637b469d4fa43d555010e235c0f77c0b2",
      "translation": "`mod` と同様ですが、常に正の結果を返します。",
      "notes": [
        "原文は「常に正」と説明していますが、固定版の[実装(英語)](https://github.com/carp-lang/Carp/blob/9f6fa9c11989eadc272ec8b10eab6eb873ae0aa5/core/Int.carp#L123) は、余りが `0` の場合は `0` を返します。また、引数 `n` が正かどうかの検査は行いません。本文は原文を保持しています。この注記はソースの確認に基づきます。"
      ]
    },
    "positive?": {
      "source": "core/Int.carp",
      "line": 89,
      "original": "returns true if `a` is positive.",
      "source_html_sha256": "93439c0f8dce9a391626c459dec682e00cfa040489b458d1928261850798616c",
      "translation": "`a` が正の場合に `true` を返します。"
    },
    "pow": {
      "source": "core/Int.carp",
      "line": 112,
      "original": "Raise x to the power of y.",
      "source_html_sha256": "4c6f94520f9d3715a11ce346c495e60967a360a36c709e984f516e1cd662d633",
      "translation": "`x` の `y` 乗を計算します。"
    },
