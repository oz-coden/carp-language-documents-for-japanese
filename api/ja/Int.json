    },
    "mod": {
      "source": "core/Int.carp",
      "line": 27,
      "original": "returns the remainder of dividing `a` by `b`.",
      "source_html_sha256": "8e826976b3c922c417497f89551e4d16e3c5463819a5ffd39d5a3b267480cd6d",
