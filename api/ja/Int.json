{
  "module": "Int",
  "upstream_commit": "9f6fa9c11989eadc272ec8b10eab6eb873ae0aa5",
  "module_documentation": {
    "source": "core/Int.carp",
    "line": 3,
    "original": "is the default integral data type.",
    "source_html_sha256": "622cbf91b8cd841763adb43df609cb809a687efca82bab6a722451b0b17ac213",
    "translation": "既定の整数データ型です。"
  },
  "entries": {
    "*": {
      "source": "core/Int.carp",
      "line": 9,
      "original": "multiplies two integers.",
      "source_html_sha256": "24c94e54557345b8e2d377dd375a2b73d7b6d9656914d9fea77cc934394165ee",
      "translation": "2 つの整数を乗算します。"
    },
    "+": {
      "source": "core/Int.carp",
      "line": 5,
      "original": "adds two integers.",
      "source_html_sha256": "d72f98f6bde2c3d2e33ee59bce2642cb2054289e1c96dc33f62afb7230da9a85",
      "translation": "2 つの整数を加算します。"
    },
    "-": {
      "source": "core/Int.carp",
      "line": 7,
      "original": "subtracts `b` from `a`.",
      "source_html_sha256": "4edc509b1c552a27fe2adb9bd0604e043ffd2d19bb93464941f69c514b184dee",
      "translation": "`a` から `b` を減算します。"
    },
    "/": {
      "source": "core/Int.carp",
      "line": 11,
      "original": "divides `a` by `b`.",
      "source_html_sha256": "f2e3fb134b8f13dc2abbcca651ee2fa6f9b96769cf6bb6d703f06ffb7a5b770d",
      "translation": "`a` を `b` で除算します。"
    },
    "<": {
      "source": "core/Int.carp",
      "line": 13,
      "original": "returns true if `a` is less than `b`.",
      "source_html_sha256": "9ed6a2e3a8a98edd8d9bee1c990d8a950ee62019f4dfdf4d33f63da4c146eef9",
      "translation": "`a` が `b` より小さい場合に `true` を返します。"
    },
    "=": {
      "source": "core/Int.carp",
      "line": 17,
      "original": "returns true if `a` equals `b`.",
      "source_html_sha256": "f23544931ff98bbeb9174b72cad6a0c766284d2a7a097a9d79c87374ce1dca08",
      "translation": "`a` と `b` が等しい場合に `true` を返します。"
    },
    ">": {
      "source": "core/Int.carp",
      "line": 15,
      "original": "returns true if `a` is greater than `b`.",
      "source_html_sha256": "20d7e5bb31d7e4333092b35e627d4e02d92afde0a0a452521e0859c9e211734e",
      "translation": "`a` が `b` より大きい場合に `true` を返します。"
    },
    "MAX": {
      "source": "core/Int.carp",
      "line": 55,
      "original": "the maximum value an Int can hold.",
      "source_html_sha256": "516e6cad7bb451643f72bac86fd9725d67ed13dc823f8e5e200a3e6d9875a6b9",
      "translation": "`Int` が保持できる最大値です。"
    },
    "MIN": {
      "source": "core/Int.carp",
      "line": 58,
      "original": "the minimum value an Int can hold.",
      "source_html_sha256": "3c634ce9923aa25c2834fc281517ec82b13e7a68bed3213f4fe54c763df81d2d",
      "translation": "`Int` が保持できる最小値です。"
    },
    "abs": {
      "source": "core/Int.carp",
      "line": 80,
      "original": "The absolute value (removes the negative sign) of an Int.",
      "source_html_sha256": "8ee34c7b3310f94f0e0139c995bec118a2441f050dc5bc3503b1e3fda2dd7282",
      "translation": "`Int` の絶対値です。負の符号を取り除きます。"
    },
    "add-ref": {
      "source": "core/Int.carp",
      "line": 99,
      "original": "adds two Int values passed as references.",
      "source_html_sha256": "d2e004dbe788d09fd5ce2dbdadd6d54ee42962efa74ea6a21eae8140500f3281",
      "translation": "参照として渡された 2 つの `Int` 値を加算します。"
    },
    "bit-and": {
      "source": "core/Int.carp",
      "line": 65,
      "original": "bitwise AND of `a` and `b`.",
      "source_html_sha256": "8d1470c3ec32874005ab7aacb123b299fad175b6cd60bdcac7b389f6d76c49c2",
      "translation": "`a` と `b` のビット単位の AND です。"
    },
    "bit-not": {
      "source": "core/Int.carp",
      "line": 71,
      "original": "bitwise NOT of `a`.",
      "source_html_sha256": "effe264b090da7d0a0a70544edf67c52d7690276d3dda700e40a59ea1f632509",
      "translation": "`a` のビット単位の NOT です。"
    },
    "bit-or": {
      "source": "core/Int.carp",
      "line": 67,
      "original": "bitwise OR of `a` and `b`.",
      "source_html_sha256": "0134a621d0a1b037e46f04cf04a353e1275c8d1437de088f576bc8180e0eafa9",
      "translation": "`a` と `b` のビット単位の OR です。"
    },
    "bit-shift-left": {
      "source": "core/Int.carp",
      "line": 61,
      "original": "shifts `a` left by `b` bits.",
      "source_html_sha256": "a9241833b1117fd7356b509efe97271bd30b42b052da784b508c5010934e0e77",
      "translation": "`a` を `b` ビット左にシフトします。"
    },
    "bit-shift-right": {
      "source": "core/Int.carp",
      "line": 63,
      "original": "shifts `a` right by `b` bits.",
      "source_html_sha256": "e71da847e5275092b79ffad9dd3793fccd19b48ae3792a775aada18dd8e2b911",
      "translation": "`a` を `b` ビット右にシフトします。"
    },
    "bit-xor": {
      "source": "core/Int.carp",
      "line": 69,
      "original": "bitwise XOR of `a` and `b`.",
      "source_html_sha256": "9b6a8634551002f579da97152d82a4a28e2c51468acf7e29fabaeaf875a07e78",
      "translation": "`a` と `b` のビット単位の XOR です。"
    },
