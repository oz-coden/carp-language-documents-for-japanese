    "unsafe-format": {
      "source": "core/String.carp",
      "line": 379,
      "original": "Formats a long. Unchecked: `s` must hold exactly one format directive. Prefer `fmt`, which checks that at compile time.",
      "source_html_sha256": "9ca02a090b2be754564cd4c3b8be1fe3dfdfdbb47cf56c2ea02f76241d82ceeb",
      "translation": "`Long` を書式化します。検査は行いません。`s` には変換指定 (directive) がちょうど 1 つ含まれている必要があります。コンパイル時にこれを検査する [`fmt`](../../docs/Format_Strings-JP.html) の使用を推奨します。"
    },
    "zero": {
      "source": "core/Long.carp",
      "line": 74,
      "original": "returns the zero value for Long (0l), used to implement the `zero` interface.",
      "source_html_sha256": "75b035e8ee4bc0073256eb6a3a2e10112fb9aa0ea3211f88a86a0b7eb89f67c7",
      "translation": "`zero` インターフェースの実装に使われる、`Long` のゼロ値 (`0l`) を返します。"
